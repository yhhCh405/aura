# Aura - Configuration Template (Copy to .env)

# Your GitLab Personal Access Token
GITLAB_TOKEN=your_gitlab_token_here

# The Merge Request you wish Aura to gracefully review
MR_URL=https://gitlab.example.com/project/-/merge_requests/123

# Remote rules URL (e.g. Confluence or raw Markdown)
# Example: https://xxxx.xxxxx.net/wiki/spaces/MD/pages/xxxxx/MR+Rules+Templates+v1.0+Active
MR_RULES_URL=https://xxxx.xxxxx.net/wiki/spaces/MD/pages/xxxxx/MR+Rules+Templates+v1.0+Active

# Aura's preferred model (e.g., qwen2.5:7b-16k)
OLLAMA_MODEL=qwen2.5:7b-16k

# Aura prefers its rules to be dynamic!
REPO_TYPE=auto

# Performance & Logging
VERBOSE=true
RESOLVE_FIXED=true
UPDATE_EXISTING=true
BOT_FOOTER="Commented by bot"
