# Aura - Configuration Template (Copy to .env)

# Your GitLab Personal Access Token
GITLAB_TOKEN=your_gitlab_token_here

# The Merge Request you wish Aura to gracefully review
MR_URL=https://gitlab.example.com/project/-/merge_requests/123

# Aura's preferred model (e.g., qwen2.5:7b-16k)
OLLAMA_MODEL=qwen2.5:7b-16k

# Where Aura can find her Ollama instance
OLLAMA_HOST=http://localhost:11434

# The rules Aura should enforce
MR_RULES_FILE=rules/mr_rules_v1.md
REPO_TYPE=auto

# Performance & Logging
VERBOSE=true
RESOLVE_FIXED=true
UPDATE_EXISTING=true
